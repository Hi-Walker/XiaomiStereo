<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <OutputType>WinExe</OutputType><AssemblyName>小米立体声</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget>
    <OutputPath>release\</OutputPath><Optimize>true</Optimize><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>5</LangVersion><Deterministic>true</Deterministic><CodePage>65001</CodePage>
    <ApplicationIcon>src\XiaomiStereo.ico</ApplicationIcon><StartupObject>StereoProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Configuration"/><Reference Include="System.Drawing"/>
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Web.Extensions"/><Reference Include="System.Runtime.Serialization"/>
    <Reference Include="netstandard"/>
    <Reference Include="NAudio.Core"><HintPath>lib\NAudio.Core.dll</HintPath></Reference>
    <Reference Include="NAudio.Wasapi"><HintPath>lib\NAudio.Wasapi.dll</HintPath></Reference>
    <Compile Include="src\*.cs"/>
    <EmbeddedResource Include="src\XiaomiStereo.ico"><LogicalName>XiaomiStereo.ico</LogicalName></EmbeddedResource>
    <None Include="app.config"/>
    <Content Include="licenses\NAudio.txt"><Link>NAudio.txt</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
